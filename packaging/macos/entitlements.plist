<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The plugin host is wasmtime with Cranelift, so it compiles every
         plugin to native code at load time. Under the hardened runtime that
         needs MAP_JIT, and MAP_JIT needs this entitlement. Without it a
         notarized Schist launches and then dies the moment it loads a
         plugin, which is to say immediately. -->
    <key>com.apple.security.cs.allow-jit</key><true/>
</dict>
</plist>
